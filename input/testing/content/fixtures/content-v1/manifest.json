      "scenario": "cnt-001",
      "category": "Patient Summary",
      "priorityCategory": "Patient-Summaries",
      "package": "hl7.fhir.eu.eps#1.0.0-ballot",
      "profile": "http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps",
      "expect": "invalid",
      "file": "invalid/eps-bundle-type.json",
      "changedFrom": "eps-valid",
      "change": "Bundle.type is \"collection\" instead of \"document\"",
      "expectedIssue": "is fixed to 'document'"
    },
    {
      "id": "eps-no-composition",
      "scenario": "cnt-001",
      "category": "Patient Summary",
      "priorityCategory": "Patient-Summaries",
      "package": "hl7.fhir.eu.eps#1.0.0-ballot",
      "profile": "http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps",
      "expect": "invalid",
      "file": "invalid/eps-no-composition.json",
      "changedFrom": "eps-valid",
      "change": "the Composition entry (the first entry of a document) is removed",
      "expectedIssue": "bdl-11"
    },
    {
      "id": "eps-status-missing",
      "scenario": "cnt-001",
      "category": "Patient Summary",
      "priorityCategory": "Patient-Summaries",
      "package": "hl7.fhir.eu.eps#1.0.0-ballot",
      "profile": "http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps",
      "expect": "invalid",
      "file": "invalid/eps-status-missing.json",
      "changedFrom": "eps-valid",
      "change": "Composition.status (1..1) is removed",
      "expectedIssue": "Composition.status: minimum required = 1"
    },
    {
      "id": "eps-status-bad-code",
      "scenario": "cnt-001",
      "category": "Patient Summary",
      "priorityCategory": "Patient-Summaries",
      "package": "hl7.fhir.eu.eps#1.0.0-ballot",
      "profile": "http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps",
      "expect": "invalid",
      "file": "invalid/eps-status-bad-code.json",
      "changedFrom": "eps-valid",
      "change": "Composition.status is \"not-a-status\", a code outside its required value set",
      "expectedIssue": "was not found in the value set 'CompositionStatus'"
    },
    {
      "id": "eps-wrong-document-type",
      "scenario": "cnt-001",
      "category": "Patient Summary",
      "priorityCategory": "Patient-Summaries",
      "package": "hl7.fhir.eu.eps#1.0.0-ballot",
      "profile": "http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps",
