      "category": "Patient Summary",
      "priorityCategory": "Patient-Summaries",
      "package": "hl7.fhir.eu.eps#1.0.0-ballot",
      "profile": "http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps",
      "expect": "valid",
      "file": "valid/eps-valid.json",
      "derivedFrom": {
        "file": "package/example/Bundle-EPSExampleBundle01NoProblemsMedicationAllergies.json",
        "sha256": "065e3ff0d5067d908bbef205fae93e667b07ec550dc38edd683c4d85fc78f854",
        "license": "CC0-1.0"
      },
      "derivation": []
    },
    {
