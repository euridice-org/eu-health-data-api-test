{
  "specification": "hl7.fhir.eu.health-data-api@1.0.0-ballot",
  "source": "https://build.fhir.org/ig/euridice-org/eu-health-data-api/en/regulatoryAnchors.html",
  "status": "draft: the covers mapping is an unreviewed judgement and must be confirmed by the specification owners",
  "errorCodes": {
    "prefix": "EUAPI",
    "rule": "The code is the prefix and the upper-cased scenario id (dap-003 gives EUAPI-DAP-003). A scenario id is never renumbered or reused: a removed scenario retires its code."
  },
  "requirements": {
    "api-provider-general": {
      "actor": "Access Provider",
      "basis": "EHDS Annex II §2.1",
      "text": "The EHR system acting as a provider SHALL provide access to its priority category data by offering an API that complies to the EHDS API specification.",
      "remediation": {
        "text": "Implement the EEHRxF Access Provider actor you claim (Document Access Provider and/or Resource Access Provider) and serve its CapabilityStatement at [base]/metadata.",
        "page": "actors.html"
      },
      "scenarios": [
        "dap-001",
        "grp-001",
        "pub-003",
        "pub-004"
      ]
    },
    "api-provider-backendAuthDiscovery": {
      "actor": "Access Provider",
      "basis": "EHDS Annex II §1.4, Art. 36(3)(e)",
      "text": "The EHR system Interoperability Software Component SHALL enable discovery of its authorization server information to enable a consumer to retrieve authorization.",
      "remediation": {
        "text": "Serve SMART configuration at [base]/.well-known/smart-configuration and declare SMART-on-FHIR in CapabilityStatement.rest.security.",
        "page": "authorization.html#authorization-server-discovery"
      },
      "scenarios": []
    },
    "api-provider-backendAuthProvideToken": {
      "actor": "Access Provider",
      "basis": "EHDS Annex II §1.4, Art. 36(3)(e)",
      "text": "The EHR system Interoperability Software Component SHALL support issuing authorization tokens to consumer EHR systems.",
      "remediation": {
        "text": "Provide a token endpoint for SMART Backend Services: the client_credentials grant with a signed JWT client assertion (ITI-71).",
        "page": "authorization.html#get-access-token"
      },
      "scenarios": []
    },
    "api-provider-backendAuthRequireToken": {
      "actor": "Access Provider",
      "basis": "EHDS Annex II §1.4, Art. 36(3)(e)",
      "text": "The EHR system Interoperability Software Component SHALL require a valid authorization token from the Consumer EHR on Interoperability Component exchange.",
      "remediation": {
        "text": "Answer a request without a valid bearer token, or with a token that lacks the system scope it needs, with 401 or 403 and an OperationOutcome, and declare SMART-on-FHIR in CapabilityStatement.rest.security.",
        "page": "authorization.html#incorporate-access-token"
      },
      "scenarios": [
        "dap-002",
        "dap-003",
        "dap-004",
        "grp-002",
        "grp-003",
        "grp-004",
        "rap-001",
        "rap-002",
        "rap-003"
      ]
    },
    "api-provider-patient": {
      "actor": "Access Provider",
      "basis": "EHDS Annex II §2.1",
      "text": "The EHR system Interoperability Software Component SHOULD offer a patient lookup API.",
      "remediation": {
        "text": "Offer Patient read and the Patient searches your CapabilityStatement names (PDQm ITI-78). Patient is a SHOULD: a server without it answers 404 or 501.",
        "page": "actors.html"
      },
      "scenarios": [
        "dap-011",
        "dap-012",
        "dap-013",
        "grp-011",
        "grp-012",
        "grp-013",
        "rap-004",
        "rap-005",
        "rap-006",
        "rap-018"
      ]
    },
    "api-provider-doc": {
      "actor": "Access Provider",
      "basis": "EHDS Annex II §2.1",
      "text": "The EHR system Interoperability Software Component SHALL offer an API that enables an external system to access and retrieve its priority category data modelled as FHIR Documents.",
      "remediation": {
        "text": "Offer MHD ITI-67 (DocumentReference search by patient, category and type) and ITI-68 (retrieve the document by Binary read, returning the raw document for its media type).",
        "page": "document-exchange.html"
      },
      "scenarios": [
        "dap-001",
        "dap-005",
        "dap-006",
        "dap-007",
        "dap-008",
        "dap-009",
        "dap-010",
        "grp-001",
        "grp-005",
        "grp-006",
        "grp-007",
        "grp-008",
        "grp-009",
        "grp-010"
      ]
    },
    "api-provider-resource": {
      "actor": "Access Provider",
      "basis": "EHDS Annex II §2.1",
      "text": "The EHR system Interoperability Software Component SHALL offer search and read access via individual FHIR Resource API(s).",
      "remediation": {
        "text": "Offer read and search-by-patient for each resource type you serve (IPA).",
        "page": "resource-access.html"
      },
      "scenarios": [
        "rap-001",
        "rap-007",
        "rap-008",
        "rap-009",
        "rap-010",
        "rap-011",
        "rap-012",
        "rap-013",
        "rap-014",
        "rap-015",
        "rap-016",
        "rap-017"
      ]
    },
    "api-consumer-general": {
      "actor": "Consumer",
      "basis": "EHDS Annex II §2.2",
      "text": "The EHR system Interoperability Software Component acting as a consumer SHALL consume external priority category data via an API conforming to the EHDS API specification.",
      "remediation": {
        "text": "Implement the EEHRxF Consumer actor you claim (Document Consumer and/or Resource Consumer).",
        "page": "actors.html"
      },
      "scenarios": []
    },
    "api-consumer-backendAuthObtainToken": {
      "actor": "Consumer",
      "basis": "EHDS Annex II §1.4, Art. 36(3)(e)",
      "text": "The EHR system Interoperability Software Component SHALL obtain an authorization token from the provider's designated authorization server.",
      "remediation": {
        "text": "Obtain a token from the provider's token endpoint with the client_credentials grant and a signed JWT client assertion (RFC 7523), and obtain a fresh token after a 401.",
        "page": "authorization.html#get-access-token"
      },
      "scenarios": [
        "con-001",
        "pub-001",
        "pub-005",
        "rc-001"
      ]
    },
    "api-consumer-backendAuthPresentToken": {
      "actor": "Consumer",
      "basis": "EHDS Annex II §1.4, Art. 36(3)(e)",
      "text": "The EHR system Interoperability Software Component SHALL present a valid token to the Provider EHR on Interoperability Component Exchange.",
      "remediation": {
        "text": "Send the header Authorization: Bearer <token> on every request.",
        "page": "authorization.html#incorporate-access-token"
      },
      "scenarios": []
    },
    "api-consumer-patient": {
      "actor": "Consumer",
      "basis": "EHDS Annex II §2.2",
      "text": "The EHR system Interoperability Software Component SHALL support an external patient lookup query API.",
      "remediation": {
        "text": "Look the patient up with Patient search (PDQm ITI-78) using the parameters the Access Provider supports.",
        "page": "actors.html"
      },
      "scenarios": [
        "con-002",
        "pub-002",
        "rc-002",
        "rc-003"
      ]
    },
    "api-consumer-doc": {
      "actor": "Consumer",
      "basis": "EHDS Annex II §2.2",
      "text": "The EHR system Interoperability Software Component SHALL support an external document query API.",
      "remediation": {
        "text": "Query documents with ITI-67 (search by patient, category or type) and retrieve them with ITI-68.",
        "page": "document-exchange.html"
      },
      "scenarios": [
        "con-003",
        "con-004",
        "con-005"
      ]
    },
    "api-consumer-resource": {
      "actor": "Consumer",
      "basis": "EHDS Annex II §2.2",
      "text": "The EHR system Interoperability Software Component SHALL support an external resource query API.",
      "remediation": {
        "text": "Query individual resources with search by patient (IPA).",
        "page": "resource-access.html"
      },
      "scenarios": [
        "rc-004",
        "rc-005",
        "rc-006"
      ]
    },
    "api-producer-data": {
      "actor": "Any system providing data",
      "basis": "EHDS Annex II 2.1, 2.4",
      "text": "The EHR system SHALL be capable of providing priority category data that conforms to the EEHRxF data format.",
      "remediation": {
        "text": "Produce documents that conform to the priority category's HL7 Europe content profile, and check them against that content IG before exchange.",
        "page": "priority-categories.html"
      },
      "scenarios": [
        "cnt-001",
        "cnt-002",
        "cnt-003"
      ]
    },
    "api-consumer-data": {
      "actor": "Any system receiving data",
      "basis": "EHDS Annex II §2.2",
      "text": "The EHR system SHALL be able to receive and handle data conforming to the EEHRxF data format.",
      "remediation": {
        "text": "Accept and process documents that conform to the EEHRxF content profiles.",
        "page": "priority-categories.html"
      },
      "scenarios": []
    },
    "api-backendEncryption": {
      "actor": "All",
      "basis": "EHDS Annex II §1.4, Art. 36(3)(e)",
      "text": "The EHR system Interoperability Component SHALL be capable of transport-encrypted data exchange.",
      "remediation": {
        "text": "Use TLS 1.2 or higher for every exchange.",
        "page": "authorization.html#transport-security"
      },
      "scenarios": [
        "con-006",
        "pub-006",
        "rc-007"
      ]
    }
  },
